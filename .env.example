# Copy to .env.local and restart `npm run dev`.

# OpenAI — Ask Aisle. Without it, recs still run on the local stylist.
OPENAI_API_KEY=

# Live inventory via Google Shopping (pick one).
# SerpAPI: https://serpapi.com — or Serper: https://serper.dev
# Without a key, search/feed stay on the seed catalog.
SERPAPI_API_KEY=
SERPER_API_KEY=
